# ============================================================================
# ParkPal Backend Test Environment
# ============================================================================
# This file is used by Jest tests to provide a clean test environment
# ============================================================================

# ----------------------------------------------------------------------------
# Core Configuration
# ----------------------------------------------------------------------------
PORT="3002"
NODE_ENV="test"
FRONTEND_URL="http://localhost:19006"

# ----------------------------------------------------------------------------
# Secret Manager (Disabled for tests)
# ----------------------------------------------------------------------------
USE_SECRET_MANAGER="false"
GCP_PROJECT_ID="test-project"

# ----------------------------------------------------------------------------
# GCP Cloud Storage Configuration
# ----------------------------------------------------------------------------
GCS_BUCKET_NAME="parkpal-dev-photos"

# ----------------------------------------------------------------------------
# Database Configuration (PostgreSQL Test Database)
# ----------------------------------------------------------------------------
# Use a dedicated test database that gets cleaned between test runs
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/parknquik_test?schema=public"

# ----------------------------------------------------------------------------
# Redis Configuration
# ----------------------------------------------------------------------------
# Use Redis database 1 for tests (production uses 0)
REDIS_URL="redis://localhost:6379/1"

# ----------------------------------------------------------------------------
# Authentication & Security
# ----------------------------------------------------------------------------
JWT_SECRET="test_jwt_secret_for_testing_only_minimum_32_characters_long"
QR_SECRET="test-qr-secret-for-testing"

# ----------------------------------------------------------------------------
# PayMongo Payment Integration (Test Mode)
# ----------------------------------------------------------------------------
PAYMONGO_SECRET_KEY="sk_test_fake_secret_key_for_testing"
PAYMONGO_PUBLIC_KEY="pk_test_fake_public_key_for_testing"
PAYMONGO_WEBHOOK_SECRET="whsec_fake_webhook_secret_for_testing"

# ----------------------------------------------------------------------------
# Google Maps API
# ----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY="test_google_maps_api_key"

# ----------------------------------------------------------------------------
# Google Sign-In
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID="test_web_oauth_client_id.apps.googleusercontent.com"

# ----------------------------------------------------------------------------
# Weather API
# ----------------------------------------------------------------------------
WEATHER_API_KEY="test_weather_api_key"

# ----------------------------------------------------------------------------
# Optional Features
# ----------------------------------------------------------------------------
ENABLE_ANALYTICS="false"
APP_VERSION="1.0.0-test"

# Production knowledge retrieval
KNOWLEDGE_PROVIDER=openai-compatible
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_CHAT_MODEL=gpt-4o-mini
KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_LEXICAL_LIMIT=20
KNOWLEDGE_VECTOR_LIMIT=20
KNOWLEDGE_FINAL_LIMIT=5
KNOWLEDGE_LEXICAL_WEIGHT=0.45
KNOWLEDGE_VECTOR_WEIGHT=0.55
KNOWLEDGE_CONTEXT_TOKEN_BUDGET=1800
KNOWLEDGE_CHUNK_TOKEN_LIMIT=420
KNOWLEDGE_CHUNK_TOKEN_OVERLAP=40
KNOWLEDGE_CACHE_TTL_SECONDS=300
KNOWLEDGE_VALIDATED_ANSWER_TTL_SECONDS=900
KNOWLEDGE_CONFIDENCE_THRESHOLD=0.18
KNOWLEDGE_RETRIEVAL_CONFIG_VERSION=v1
KNOWLEDGE_SOURCE_CONFIG_PATH=config/knowledge/sources.json
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
