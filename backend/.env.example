# ============================================================================
# ParkPal Backend Environment Variables
# ============================================================================
# This file shows all required and optional environment variables.
# Copy this file to .env and fill in your actual values.
#
# SECRET MANAGER MODES:
# - Development: USE_SECRET_MANAGER=false (reads from this .env file)
# - Production:  USE_SECRET_MANAGER=true  (reads from GCP Secret Manager)
# ============================================================================

# ----------------------------------------------------------------------------
# Core Configuration
# ----------------------------------------------------------------------------
PORT="3001"
NODE_ENV="development"  # Options: development, production, test
FRONTEND_URL="http://localhost:19006"  # Mobile app URL for redirects

# ----------------------------------------------------------------------------
# GCP Secret Manager Configuration
# ----------------------------------------------------------------------------
# Set USE_SECRET_MANAGER=true to use GCP Secret Manager (recommended for production)
# Set USE_SECRET_MANAGER=false to use local environment variables (development only)
USE_SECRET_MANAGER="false"
GCP_PROJECT_ID="your-gcp-project-id"
GOOGLE_APPLICATION_CREDENTIALS="path/to/service-account-key.json"

# ----------------------------------------------------------------------------
# GCP Cloud Storage Configuration (Photo Upload)
# ----------------------------------------------------------------------------
# Required for photo upload feature.
# Local development should use the dev bucket; deployed production sets this to
# parkpal-prod-photos in the Cloud Run deploy workflow.
# Uses the same GCP_PROJECT_ID and GOOGLE_APPLICATION_CREDENTIALS as above
GCS_BUCKET_NAME="parkpal-dev-photos"
# Optional: Override default key file path for storage
GCP_KEYFILE_PATH="path/to/service-account-key.json"

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# GCP Secret Name: database-url
# Development fallback (when USE_SECRET_MANAGER=false):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/parknquik?schema=public"

# ----------------------------------------------------------------------------
# Redis Configuration
# ----------------------------------------------------------------------------
# GCP Secret Name: redis-url
# Development fallback (when USE_SECRET_MANAGER=false):
REDIS_URL="redis://localhost:6379"

# ----------------------------------------------------------------------------
# Authentication & Security
# ----------------------------------------------------------------------------
# GCP Secret Name: jwt-secret
# IMPORTANT: Generate a strong 128+ character secret for production!
# Development fallback (when USE_SECRET_MANAGER=false):
JWT_SECRET="test_jwt_secret_for_development_only_do_not_use_in_production_12345678"

# GCP Secret Name: qr-secret
# Secret for QR code generation and validation
# Development fallback (when USE_SECRET_MANAGER=false):
QR_SECRET="parkpal-development-qr-secret"

# ----------------------------------------------------------------------------
# PayMongo Payment Integration
# ----------------------------------------------------------------------------
# GCP Secret Names: paymongo-secret-key, paymongo-public-key, paymongo-webhook-secret
# Get your keys from: https://dashboard.paymongo.com/developers/api-keys
# Development fallback (when USE_SECRET_MANAGER=false):
PAYMONGO_SECRET_KEY="sk_test_your_secret_key_here"
PAYMONGO_PUBLIC_KEY="pk_test_your_public_key_here"
PAYMONGO_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# ----------------------------------------------------------------------------
# Google Maps API (Web/Mobile Maps)
# ----------------------------------------------------------------------------
# GCP Secret Name: google-maps-api-key
# Get your key from: https://console.cloud.google.com/apis/credentials
# Use a browser/app-restricted key for map rendering clients.
# Development fallback (when USE_SECRET_MANAGER=false):
GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# ----------------------------------------------------------------------------
# Google Places API (Backend)
# ----------------------------------------------------------------------------
# GCP Secret Name: google-places-api-key
# Use a server/IP-restricted key for backend Places requests.
# Backend parking candidate scans prefer this key over GOOGLE_MAPS_API_KEY.
# Development fallback (when USE_SECRET_MANAGER=false):
GOOGLE_PLACES_API_KEY="your_google_places_backend_api_key"

# ----------------------------------------------------------------------------
# Google Sign-In
# ----------------------------------------------------------------------------
# Web OAuth client ID used as the audience for mobile id_token verification.
# Must match frontend/mobile EXPO_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID="your_web_oauth_client_id.apps.googleusercontent.com"

# Legacy browser OAuth code exchange compatibility only.
GOOGLE_CLIENT_SECRET="your_web_oauth_client_secret"
GOOGLE_REDIRECT_URI="parknquik://"

# ----------------------------------------------------------------------------
# Google Parking Candidate Discovery (Optional)
# ----------------------------------------------------------------------------
# Disabled by default. Manual admin scans remain available without enabling cron.
GOOGLE_PARKING_SCAN_ENABLED="false"
GOOGLE_PARKING_SCAN_CRON="0 3 * * 0"
GOOGLE_PARKING_SCAN_MAX_PAGES="1"

# ----------------------------------------------------------------------------
# Weather API (Optional)
# ----------------------------------------------------------------------------
# GCP Secret Name: weather-api-key
# Get your key from: https://openweathermap.org/api
# Development fallback (when USE_SECRET_MANAGER=false):
WEATHER_API_KEY="test_weather_api_key"

# ----------------------------------------------------------------------------
# Email Service (Resend)
# ----------------------------------------------------------------------------
# GCP Secret Name: resend-api-key
# Get your API key from: https://resend.com/api-keys
# Free tier: 3,000 emails/month, 100 emails/day
# Development fallback (when USE_SECRET_MANAGER=false):
RESEND_API_KEY="re_your_api_key_here"

# ----------------------------------------------------------------------------
# Optional Features
# ----------------------------------------------------------------------------
ENABLE_ANALYTICS="false"
APP_VERSION="1.0.0"

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================================================
# Before deploying to production:
# [ ] Set USE_SECRET_MANAGER=true
# [ ] Create all secrets in GCP Secret Manager (see setup script)
# [ ] Set NODE_ENV=production
# [ ] Generate new JWT_SECRET (128+ chars)
# [ ] Generate new QR_SECRET (32+ chars)
# [ ] Use live PayMongo keys (sk_live_*, pk_live_*)
# [ ] Set strong database credentials
# [ ] Enable SSL for database (?sslmode=require)
# [ ] Update FRONTEND_URL to production URL
# [ ] Create GCS bucket for photo storage (GCS_BUCKET_NAME)
# [ ] Set up GCS service account with Storage Object Creator/Viewer permissions
# [ ] Set up Resend API key and verify domain (RESEND_API_KEY)
# ============================================================================
