# Database
DATABASE_URL="postgresql://user:password@localhost:5432/parkpal"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-128-characters-here"

# GCP Secret Manager Configuration
# Set USE_SECRET_MANAGER=true to use GCP Secret Manager (recommended for production)
# Set USE_SECRET_MANAGER=false to use local environment variables (development only)
USE_SECRET_MANAGER="false"
GCP_PROJECT_ID="your-gcp-project-id"
GOOGLE_APPLICATION_CREDENTIALS="path/to/service-account-key.json"

# PayMongo API Keys (Local Development - fallback when USE_SECRET_MANAGER=false)
# In production, these should be stored in GCP Secret Manager with names:
#   - paymongo-secret-key
#   - paymongo-public-key
#   - paymongo-webhook-secret
PAYMONGO_SECRET_KEY="sk_test_your_secret_key_here"
PAYMONGO_PUBLIC_KEY="pk_test_your_public_key_here"
PAYMONGO_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# Frontend URL (for PayMongo redirects)
FRONTEND_URL="http://localhost:19006"

# Environment
NODE_ENV="development"

# Google Maps
GOOGLE_MAPS_API_KEY="your_google_maps_api_key"
