# Server Configuration
PORT=3001
NODE_ENV=development

# Database
# Development (Docker PostgreSQL - recommended)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/parknquik?schema=public

# Legacy SQLite (deprecated - use PostgreSQL)
# DATABASE_URL=file:./dev.db

# Production PostgreSQL (Cloud)
# DATABASE_URL=postgresql://user:password@host:5432/parknquik?schema=public&connection_limit=20&pool_timeout=10

# Connection pooling (for production)
# DATABASE_URL=postgresql://user:password@host:5432/parknquik?schema=public&connection_limit=20&pool_timeout=10&connect_timeout=10

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your_jwt_secret_change_this_in_production_use_long_random_string

# External APIs
# Get from: https://home.openweathermap.org/api_keys
WEATHER_API_KEY=your_openweathermap_api_key

# Google Cloud Platform
USE_SECRET_MANAGER=true
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Google Maps API (for geocoding, optional)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
