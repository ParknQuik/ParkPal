generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int                 @id @default(autoincrement())
  name                 String?
  email                String              @unique
  password             String
  role                 String
  phone                String?
  profileImageUrl      String?             @map("profile_image_url")
  isActive             Boolean             @default(true) @map("is_active")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  resetPasswordToken   String?             @map("reset_password_token")
  resetPasswordExpires DateTime?           @map("reset_password_expires")
  googleId             String?             @unique @map("google_id")
  pushToken            String?             @map("push_token")
  noShowCount          Int                 @default(0) @map("no_show_count")
  lateCancelCount      Int                 @default(0) @map("late_cancel_count")
  suspendedUntil       DateTime?           @map("suspended_until")
  lastStrikeAt         DateTime?           @map("last_strike_at")
  activityEvents       ActivityEvent[]
  bookings             Booking[]
  notifications        Notification[]
  parkingSessions      ParkingSession[]
  ownedSlots           ParkingSlot[]       @relation("SlotOwner")
  payments             Payment[]
  payouts              Payout[]            @relation("HostPayouts")
  reviews              Review[]            @relation("ReviewAuthor")
  receivedReviews      Review[]            @relation("ReviewTarget")
  vehicles             Vehicle[]
  pointsTransactions   PointsTransaction[]
  referralsGiven       Referral[]          @relation("ReferrerReferrals")
  referralsReceived    Referral[]          @relation("ReferredReferrals")

  @@map("users")
}

model Zone {
  id              Int              @id @default(autoincrement())
  name            String
  type            String
  address         String
  city            String
  geofencePolygon String           @map("geofence_polygon")
  centerLat       Float            @map("center_lat")
  centerLon       Float            @map("center_lon")
  radiusMeters    Float?           @map("radius_meters")
  totalCapacity   Int              @default(0) @map("total_capacity")
  pricePerHour    Float?           @map("price_per_hour")
  operatingHours  String?          @map("operating_hours")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  parkingSessions ParkingSession[]
  parkingSlots    ParkingSlot[]
  sensorEvents    SensorEvent[]
  zoneMetrics     ZoneMetrics[]

  @@map("zones")
}

model ParkingSlot {
  id              Int              @id @default(autoincrement())
  zoneId          Int?             @map("zone_id")
  slotNumber      String?          @map("slot_number")
  lat             Float
  lon             Float
  address         String
  floor           String?
  section         String?
  slotType        String           @map("slot_type")
  sensorId        String?          @unique @map("sensor_id")
  qrCode          String?          @unique @map("qr_code")
  status          String           @default("available")
  price           Float
  description     String?
  amenities       String?
  photos          String?
  rating          Float            @default(0)
  ownerId         Int?             @map("owner_id")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  title           String?
  bookings        Booking[]
  parkingSessions ParkingSession[]
  owner           User?            @relation("SlotOwner", fields: [ownerId], references: [id])
  zone            Zone?            @relation(fields: [zoneId], references: [id])
  slotPhotos      Photo[]
  reviews         Review[]         @relation("SlotReviews")
  sensorEvents    SensorEvent[]

  @@index([lat, lon])
  @@index([isActive, status])
  @@index([ownerId])
  @@index([createdAt])
  @@index([price])
  @@index([zoneId])
  @@map("parking_slots")
}

model Photo {
  id           Int         @id @default(autoincrement())
  slotId       Int         @map("slot_id")
  originalUrl  String      @map("original_url")
  largeUrl     String      @map("large_url")
  mediumUrl    String      @map("medium_url")
  thumbnailUrl String      @map("thumbnail_url")
  position     Int         @default(0)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  slot         ParkingSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([slotId])
  @@map("photos")
}

model ParkingSession {
  id                      Int             @id @default(autoincrement())
  userId                  Int             @map("user_id")
  zoneId                  Int?            @map("zone_id")
  slotId                  Int?            @map("slot_id")
  bookingId               Int?            @map("booking_id")
  sessionType             String          @map("session_type")
  checkInTime             DateTime?       @map("check_in_time")
  checkOutTime            DateTime?       @map("check_out_time")
  durationMinutes         Int?            @map("duration_minutes")
  zoneEntryTime           DateTime?       @map("zone_entry_time")
  circlingStartTime       DateTime?       @map("circling_start_time")
  parkingConfirmationTime DateTime?       @map("parking_confirmation_time")
  circlingEndTime         DateTime?       @map("circling_end_time")
  exitTime                DateTime?       @map("exit_time")
  circlingDurationSeconds Int?            @map("circling_duration_seconds")
  lastActivityStatus      String?         @map("last_activity_status")
  activityConfidenceLevel Int?            @map("activity_confidence_level")
  totalAmount             Float?          @map("total_amount")
  status                  String          @default("active")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")
  activityEvents          ActivityEvent[]
  booking                 Booking?        @relation(fields: [bookingId], references: [id])
  slot                    ParkingSlot?    @relation(fields: [slotId], references: [id])
  user                    User            @relation(fields: [userId], references: [id])
  zone                    Zone?           @relation(fields: [zoneId], references: [id])
  payments                Payment[]

  @@index([userId])
  @@index([slotId])
  @@index([zoneId])
  @@index([status])
  @@index([checkInTime])
  @@index([createdAt])
  @@map("parking_sessions")
}

model SensorEvent {
  id        Int          @id @default(autoincrement())
  sensorId  String       @map("sensor_id")
  zoneId    Int?         @map("zone_id")
  slotId    Int?         @map("slot_id")
  eventType String       @map("event_type")
  eventData String?      @map("event_data")
  timestamp DateTime     @default(now())
  createdAt DateTime     @default(now()) @map("created_at")
  slot      ParkingSlot? @relation(fields: [slotId], references: [id])
  zone      Zone?        @relation(fields: [zoneId], references: [id])

  @@map("sensor_events")
}

model ActivityEvent {
  id           Int             @id @default(autoincrement())
  userId       Int             @map("user_id")
  sessionId    Int?            @map("session_id")
  activityType String          @map("activity_type")
  confidence   Int
  latitude     Float?
  longitude    Float?
  timestamp    DateTime        @default(now())
  createdAt    DateTime        @default(now()) @map("created_at")
  session      ParkingSession? @relation(fields: [sessionId], references: [id])
  user         User            @relation(fields: [userId], references: [id])

  @@map("activity_events")
}

model ZoneMetrics {
  id                     Int      @id @default(autoincrement())
  zoneId                 Int      @map("zone_id")
  timestamp              DateTime
  periodType             String   @map("period_type")
  totalSlots             Int      @map("total_slots")
  occupiedSlots          Int      @map("occupied_slots")
  availableSlots         Int      @map("available_slots")
  occupancyPercentage    Float    @map("occupancy_percentage")
  avgCirclingTimeSeconds Int?     @map("avg_circling_time_seconds")
  minCirclingTimeSeconds Int?     @map("min_circling_time_seconds")
  maxCirclingTimeSeconds Int?     @map("max_circling_time_seconds")
  totalSessions          Int      @default(0) @map("total_sessions")
  totalRevenue           Float?   @map("total_revenue")
  createdAt              DateTime @default(now()) @map("created_at")
  zone                   Zone     @relation(fields: [zoneId], references: [id])

  @@map("zone_metrics")
}

model Booking {
  id                 Int              @id @default(autoincrement())
  slotId             Int              @map("slot_id")
  userId             Int              @map("user_id")
  startTime          DateTime         @map("start_time")
  endTime            DateTime?        @map("end_time")
  price              Float
  platformFee        Float            @default(0) @map("platform_fee")
  hostEarnings       Float            @map("host_earnings")
  status             String           @default("pending")
  cancelledAt        DateTime?        @map("cancelled_at")
  cancellationReason String?          @map("cancellation_reason")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  authAmount         Float?           @map("auth_amount")
  authId             String?          @map("auth_id")
  maxDuration        Int?             @map("max_duration")
  rentalMode         String           @default("fixed") @map("rental_mode")
  originalEndTime    DateTime?        @map("original_end_time")
  extensionCount     Int              @default(0) @map("extension_count")
  totalExtensionHrs  Int              @default(0) @map("total_extension_hrs")
  lastExtendedAt     DateTime?        @map("last_extended_at")
  slot               ParkingSlot      @relation(fields: [slotId], references: [id])
  user               User             @relation(fields: [userId], references: [id])
  sessions           ParkingSession[]
  payments           Payment[]
  review             Review?          @relation("BookingReview")

  @@index([userId])
  @@index([slotId])
  @@index([status])
  @@index([startTime, endTime])
  @@index([createdAt])
  @@map("bookings")
}

model Payout {
  id             Int       @id @default(autoincrement())
  hostId         Int       @map("host_id")
  amount         Float
  currency       String    @default("PHP")
  status         String    @default("pending")
  periodStart    DateTime  @map("period_start")
  periodEnd      DateTime  @map("period_end")
  paymentMethod  String?   @map("payment_method")
  accountDetails String?   @map("account_details")
  processedAt    DateTime? @map("processed_at")
  transactionId  String?   @unique @map("transaction_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  host           User      @relation("HostPayouts", fields: [hostId], references: [id])

  @@map("payouts")
}

model Payment {
  id            Int             @id @default(autoincrement())
  userId        Int             @map("user_id")
  sessionId     Int?            @map("session_id")
  bookingId     Int?            @map("booking_id")
  amount        Float
  currency      String          @default("PHP")
  paymentMethod String          @map("payment_method")
  status        String          @default("pending")
  transactionId String?         @unique @map("transaction_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  booking       Booking?        @relation(fields: [bookingId], references: [id])
  session       ParkingSession? @relation(fields: [sessionId], references: [id])
  user          User            @relation(fields: [userId], references: [id])

  @@map("payments")
}

model Review {
  id        Int          @id @default(autoincrement())
  authorId  Int          @map("author_id")
  targetId  Int?         @map("target_id")
  slotId    Int?         @map("slot_id")
  bookingId Int?         @unique @map("booking_id")
  rating    Int
  comment   String?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  author    User         @relation("ReviewAuthor", fields: [authorId], references: [id])
  booking   Booking?     @relation("BookingReview", fields: [bookingId], references: [id])
  slot      ParkingSlot? @relation("SlotReviews", fields: [slotId], references: [id])
  target    User?        @relation("ReviewTarget", fields: [targetId], references: [id])

  @@index([slotId])
  @@index([authorId])
  @@index([createdAt])
  @@map("reviews")
}

model Vehicle {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  make         String
  model        String
  year         Int?
  color        String?
  licensePlate String   @unique @map("license_plate")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  isActive     Boolean  @default(true) @map("is_active")
  imageUrl     String?  @map("image_url")
  user         User     @relation(fields: [userId], references: [id])

  @@map("vehicles")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String
  body      String
  type      String   @default("general")
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// LOYALTY POINTS & REFERRAL SYSTEM
// ============================================

model PointsTransaction {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  amount        Int       @map("amount")
  balanceAfter  Int       @map("balance_after")
  type          String    @map("type") // EARNED, SPENT, EXPIRED, REFERRAL_BONUS, REFERRAL_REWARD
  source        String?   @map("source") // BOOKING, REFERRAL_NEW_USER, REFERRAL_FIRST_BOOKING, MANUAL_ADJUSTMENT
  referenceId   Int?      @map("reference_id") // bookingId, referralId, etc.
  referenceType String?   @map("reference_type") // BOOKING, REFERRAL
  description   String?   @map("description")
  expiresAt     DateTime? @map("expires_at")
  isExpired     Boolean   @default(false) @map("is_expired")
  status        String    @default("active") // active, expired, consumed
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  user           User      @relation(fields: [userId], references: [id])
  referralReward Referral?

  // Indexes for querying
  @@index([userId])
  @@index([expiresAt])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("points_transactions")
}

// ============================================
// REFERRAL SYSTEM
// ============================================

model Referral {
  id Int @id @default(autoincrement())

  // Referrer (existing user who invited)
  referrerId Int @map("referrer_id")

  // Referred (new user who signed up)
  referredId Int @map("referred_id")

  // The referral code used (snapshot at time of signup)
  referralCode String @map("referral_code")

  // Status tracking
  status String @default("pending") // pending, active, first_booking_completed, rewarded, expired

  // Reward tracking
  rewardAmount  Int?      @map("reward_amount") // Points awarded to referrer (100 pts)
  rewardGivenAt DateTime? @map("reward_given_at") // When reward was issued

  // Reference to reward transaction (if reward was issued)
  rewardTransactionId Int? @map("reward_transaction_id")

  // First booking milestone (when referred user completes first paid booking)
  firstBookingAt DateTime? @map("first_booking_at")

  // Expiration (1 year from signup, per requirements)
  expiresAt DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  referrer          User               @relation("ReferrerReferrals", fields: [referrerId], references: [id])
  referred          User               @relation("ReferredReferrals", fields: [referredId], references: [id])
  rewardTransaction PointsTransaction? @relation(fields: [rewardTransactionId], references: [id])

  // Unique constraint: referred user can only be referred once
  @@unique([referredId])
  @@unique([referralCode])
  @@unique([rewardTransactionId], map: "referrals_reward_txn_id_key")
  // Indexes
  @@index([referrerId])
  @@index([referredId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("referrals")
}
