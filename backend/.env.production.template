# ============================================================================
# ParkPal Backend - PRODUCTION Environment Template
# ============================================================================
# This file is a template for production environment variables.
# DO NOT commit actual secrets to git!
#
# USAGE INSTRUCTIONS:
# 1. Generate strong secrets using the provided script (see below)
# 2. Store secrets in GCP Secret Manager (recommended)
# 3. Set USE_SECRET_MANAGER=true in production
# 4. Configure Cloud Run to use service account with Secret Manager access
#
# GENERATING SECRETS:
# Run this command to generate cryptographically secure secrets:
#   node -e "const crypto = require('crypto'); console.log('JWT_SECRET:', crypto.randomBytes(128).toString('hex')); console.log('DB_PASSWORD:', crypto.randomBytes(32).toString('base64').replace(/[^a-zA-Z0-9]/g, '').substring(0, 40)); console.log('QR_SECRET:', crypto.randomBytes(32).toString('hex'));"
#
# GCP SECRET MANAGER SETUP:
# For each secret below, create it in GCP Secret Manager:
#   gcloud secrets create jwt-secret --data-file=- <<< "YOUR_JWT_SECRET_HERE"
#   gcloud secrets create database-url --data-file=- <<< "YOUR_DATABASE_URL_HERE"
#   gcloud secrets create paymongo-secret-key --data-file=- <<< "YOUR_PAYMONGO_SECRET_KEY"
# etc.
# ============================================================================

# ----------------------------------------------------------------------------
# Core Configuration
# ----------------------------------------------------------------------------
PORT="8080"  # Cloud Run default port
NODE_ENV="production"
FRONTEND_URL="https://your-production-app.com"  # Update with actual production URL

# ----------------------------------------------------------------------------
# GCP Secret Manager Configuration (REQUIRED FOR PRODUCTION)
# ----------------------------------------------------------------------------
USE_SECRET_MANAGER="true"  # MUST be true in production
GCP_PROJECT_ID="your-gcp-project-id"  # Replace with actual GCP project ID
# GOOGLE_APPLICATION_CREDENTIALS not needed in Cloud Run (uses service account)

# ----------------------------------------------------------------------------
# GCP Cloud Storage Configuration (Photo Upload)
# ----------------------------------------------------------------------------
# Production uploads use the production photos bucket. Development and staging
# deployments are configured separately by the deploy workflow.
GCS_BUCKET_NAME="parkpal-prod-photos"

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# GCP Secret Name: database-url
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
#
# SECURITY REQUIREMENTS:
# - Password: 32+ characters, alphanumeric, cryptographically random
# - SSL Mode: MUST be "require" for production
# - Use Cloud SQL Proxy or private IP for GCP deployments
#
# Example (DO NOT USE THIS - GENERATE YOUR OWN):
# DATABASE_URL="postgresql://parkpal_prod:YOUR_40_CHAR_PASSWORD@10.123.45.67:5432/parkpal_production?schema=public&connection_limit=20&pool_timeout=10&connect_timeout=10&sslmode=require"

# ----------------------------------------------------------------------------
# Redis Configuration (Optional but Recommended)
# ----------------------------------------------------------------------------
# GCP Secret Name: redis-url
# Format: redis://[username:password@]host:port[/database]
#
# For GCP Memorystore:
# REDIS_URL="redis://10.x.x.x:6379"
#
# For Redis with auth:
# REDIS_URL="redis://:YOUR_REDIS_PASSWORD@10.x.x.x:6379"

# ----------------------------------------------------------------------------
# Authentication & Security
# ----------------------------------------------------------------------------
# GCP Secret Name: jwt-secret
# CRITICAL: Generate a cryptographically secure 256-character (128 bytes hex) secret
# This secret is used to sign JWT tokens - if compromised, all tokens are vulnerable
#
# Generate with: node -e "console.log(require('crypto').randomBytes(128).toString('hex'))"
# Length: MUST be 256 characters (128 bytes in hex)
#
# Example format (DO NOT USE THIS - GENERATE YOUR OWN):
# JWT_SECRET="305c4c755523e4f862758efd697deb20c8aca77714bf4502e50f22c8e27af0ea..."

# GCP Secret Name: qr-secret
# Secret for QR code generation and validation
# Length: 64 characters (32 bytes in hex)
#
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Example format (DO NOT USE THIS - GENERATE YOUR OWN):
# QR_SECRET="28b9a6e6216a9a0e4bf368fba886358de5de9d5a4b2f3d172163cf491f7f0c19"

# ----------------------------------------------------------------------------
# PayMongo Payment Integration
# ----------------------------------------------------------------------------
# GCP Secret Names: paymongo-secret-key, paymongo-public-key, paymongo-webhook-secret
#
# IMPORTANT: Use LIVE keys for production (sk_live_*, pk_live_*)
# Get your keys from: https://dashboard.paymongo.com/developers/api-keys
#
# PAYMONGO_SECRET_KEY="sk_live_YOUR_SECRET_KEY_HERE"
# PAYMONGO_PUBLIC_KEY="pk_live_YOUR_PUBLIC_KEY_HERE"
# PAYMONGO_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SECRET_HERE"

# ----------------------------------------------------------------------------
# Google Maps API
# ----------------------------------------------------------------------------
# GCP Secret Name: google-maps-api-key
# Get your key from: https://console.cloud.google.com/apis/credentials
#
# SECURITY: Restrict this key by:
# - HTTP referrers (for web app)
# - Android/iOS bundle IDs (for mobile app)
# - IP addresses (for backend API)
#
# GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# ----------------------------------------------------------------------------
# Google Sign-In
# ----------------------------------------------------------------------------
# GCP Secret Name: google-client-id
# Web OAuth client ID used as the audience for mobile id_token verification.
# Must match frontend/mobile EXPO_PUBLIC_GOOGLE_CLIENT_ID.
#
# GOOGLE_CLIENT_ID="YOUR_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com"
#
# Legacy browser OAuth code exchange compatibility only:
# GOOGLE_CLIENT_SECRET="YOUR_WEB_OAUTH_CLIENT_SECRET"
# GOOGLE_REDIRECT_URI="parknquik://"

# ----------------------------------------------------------------------------
# Weather API (Optional)
# ----------------------------------------------------------------------------
# GCP Secret Name: weather-api-key
# Get your key from: https://openweathermap.org/api
#
# WEATHER_API_KEY="YOUR_WEATHER_API_KEY"

# ----------------------------------------------------------------------------
# Optional Features
# ----------------------------------------------------------------------------
ENABLE_ANALYTICS="true"
APP_VERSION="1.0.0"  # Update with each deployment

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================================================
# BEFORE DEPLOYING TO PRODUCTION, VERIFY ALL ITEMS:
#
# [ ] Set NODE_ENV=production
# [ ] Set USE_SECRET_MANAGER=true
# [ ] Generated new JWT_SECRET (256 chars, cryptographically random)
# [ ] Generated new QR_SECRET (64 chars, cryptographically random)
# [ ] Generated strong DB password (40+ chars, alphanumeric)
# [ ] Enabled SSL for database (sslmode=require)
# [ ] Using live PayMongo keys (sk_live_*, pk_live_*)
# [ ] Configured GCP Secret Manager with all secrets
# [ ] Set production FRONTEND_URL
# [ ] Restricted Google Maps API key
# [ ] Configured Cloud SQL with private IP or proxy
# [ ] Set up Cloud Run service account with Secret Manager access
# [ ] Enabled Cloud Run VPC connector for Cloud SQL/Memorystore
# [ ] Configured CORS for production frontend domain
# [ ] Set up Cloud Monitoring and Error Reporting
# [ ] Configured Cloud Armor (optional, for DDoS protection)
# [ ] Set up automated backups for Cloud SQL
# [ ] Configured SSL certificate for custom domain
#
# ============================================================================
