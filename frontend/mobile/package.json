    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "react-native-worklets-core": "^1.6.2",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "expo-modules-core": "58.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.0",
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "^30.0.0",
    "@types/react": "19.3.0",
    "dotenv": "^16.3.1",
    "jest": "^30.0.5",
    "jest-expo": "~58.0.14",
    "test-renderer": "^1.3.0",
    "typescript": "6.0.3"
  },
  "private": true,
