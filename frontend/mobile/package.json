{
  "name": "parknquik-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "npm run fetch:secrets && npx expo start",
    "start:dev": "npm run fetch:secrets && EXPO_PUBLIC_ENV=development npx expo start",
    "start:staging": "npm run fetch:secrets && EXPO_PUBLIC_ENV=staging npx expo start",
    "start:no-fetch": "npx expo start",
    "android": "npm run fetch:secrets && npx expo start --android",
    "ios": "npm run fetch:secrets && npx expo start --ios",
    "web": "npm run fetch:secrets && npx expo start --web",
    "build:dev:ios": "npm run fetch:secrets && eas build --platform ios --profile development",
    "build:dev:android": "npm run fetch:secrets && eas build --platform android --profile development",
    "build:staging:ios": "npm run fetch:secrets && eas build --platform ios --profile staging",
    "build:staging:android": "npm run fetch:secrets && eas build --platform android --profile staging",
    "build:prod:ios": "npm run fetch:secrets && eas build --platform ios --profile production",
    "build:prod:android": "npm run fetch:secrets && eas build --platform android --profile production",
    "fetch:secrets": "node scripts/fetch-secrets-from-gcp.js",
    "setup:eas": "./scripts/setup-eas-secrets.sh",
    "env:check": "node scripts/check-env.js",
    "doctor": "npx expo doctor",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@expo-google-fonts/material-symbols": "^0.4.28",
    "@expo/metro-runtime": "~6.1.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@reduxjs/toolkit": "^2.11.1",
    "@turf/turf": "^7.3.5",
    "axios": "^1.6.2",
    "expo": "~54.0.33",
    "expo-auth-session": "~7.0.10",
    "expo-barcode-scanner": "^13.0.1",
    "expo-camera": "~17.0.8",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.7",
    "expo-location": "~19.0.7",
    "expo-notifications": "~0.32.16",
    "expo-sharing": "~14.0.7",
    "expo-status-bar": "~3.0.8",
    "expo-task-manager": "~14.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "^0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-places-autocomplete": "^2.5.7",
    "react-native-maps": "1.20.1",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.5.1",
    "react-native-worklets-core": "^1.6.2",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.3",
    "@types/jest": "^29.5.11",
    "@types/react": "~19.1.10",
    "dotenv": "^16.3.1",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.17",
    "react-test-renderer": "^19.1.0",
    "typescript": "^5.3.3"
  },
  "private": true
}
