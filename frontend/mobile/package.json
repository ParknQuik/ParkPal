{
  "name": "parknquik-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "npm run fetch:secrets && npx expo start",
    "start:dev": "npm run fetch:secrets && EXPO_PUBLIC_ENV=development npx expo start",
    "start:staging": "npm run fetch:secrets && EXPO_PUBLIC_ENV=staging npx expo start",
    "start:no-fetch": "npx expo start",
    "android": "npm run fetch:secrets && npx expo start --android",
    "ios": "npm run fetch:secrets && npx expo start --ios",
    "web": "npm run fetch:secrets && npx expo start --web",
    "build:dev:ios": "npm run fetch:secrets && eas build --platform ios --profile development",
    "build:dev:android": "npm run fetch:secrets && eas build --platform android --profile development",
    "build:staging:ios": "npm run fetch:secrets && eas build --platform ios --profile staging",
    "build:staging:android": "npm run fetch:secrets && eas build --platform android --profile staging",
    "build:prod:ios": "npm run fetch:secrets && eas build --platform ios --profile production",
    "build:prod:android": "npm run fetch:secrets && eas build --platform android --profile production",
    "fetch:secrets": "node scripts/fetch-secrets-from-gcp.js",
    "setup:eas": "./scripts/setup-eas-secrets.sh",
    "env:check": "node scripts/check-env.js",
    "doctor": "npx expo doctor",
    "test": "jest --watchAll=false",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --watchAll=false",
    "build:local:ios": "eas build --platform ios --profile local-development",
    "build:local:android": "eas build --platform android --profile local-development"
  },
  "dependencies": {
    "@expo-google-fonts/material-symbols": "^0.4.28",
    "@expo/metro-runtime": "58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/stack": "7.12.1",
    "@reduxjs/toolkit": "^2.11.1",
    "@turf/turf": "^7.3.5",
    "axios": "1.21.1",
    "expo": "^58.0.25",
    "expo-apple-authentication": "58.0.3",
    "expo-camera": "58.0.14",
    "expo-dev-client": "58.0.20",
    "expo-device": "58.0.5",
    "expo-font": "58.0.12",
    "expo-haptics": "58.0.8",
    "expo-image": "58.0.18",
    "expo-image-manipulator": "58.0.16",
    "expo-image-picker": "58.0.10",
    "expo-linear-gradient": "58.0.4",
    "expo-location": "58.0.22",
    "expo-notifications": "58.1.9",
    "expo-secure-store": "58.0.3",
    "expo-sharing": "58.0.23",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "58.0.14",
    "expo-web-browser": "58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "3.3.0",
    "react-native-google-places-autocomplete": "2.6.5",
    "react-native-maps": "1.29.11",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "4.7.1",
