# Staging Environment
# DO NOT commit actual API keys - use EAS Secrets for builds

EXPO_PUBLIC_ENV=staging

# Staging backend API URL
EXPO_PUBLIC_API_URL=https://staging-api.parknquik.com/api/v1

# Staging API keys - Set via EAS Secrets: npx eas secret:create
GOOGLE_MAPS_API_KEY_IOS=YOUR_STAGING_IOS_API_KEY_HERE
GOOGLE_MAPS_API_KEY_ANDROID=YOUR_STAGING_ANDROID_API_KEY_HERE
