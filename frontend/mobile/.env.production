# Production Environment
# DO NOT commit actual API keys - use EAS Secrets for builds

EXPO_PUBLIC_ENV=production

# Production backend API URL
EXPO_PUBLIC_API_URL=https://api.parknquik.com/api/v1

# Production API keys - Set via EAS Secrets: npx eas secret:create
GOOGLE_MAPS_API_KEY_IOS=YOUR_PRODUCTION_IOS_API_KEY_HERE
GOOGLE_MAPS_API_KEY_ANDROID=YOUR_PRODUCTION_ANDROID_API_KEY_HERE
