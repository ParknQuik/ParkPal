# ParknQuik Mobile - Local Development Environment
# Copy this file to .env.local and fill in your values

# ============================================
# ENVIRONMENT
# ============================================
EXPO_PUBLIC_ENV=development

# ============================================
# BACKEND API - HYBRID APPROACH
# ============================================
# Zero configuration for simulators/emulators!
# Auto-detects:
# - iOS Simulator: localhost:3001 (automatic)
# - Android Emulator: 10.0.2.2:3001 (automatic)
# - Physical Devices: [HOSTNAME].local:3001 (set below)
#
# Step 1: Find your Mac's hostname
#   Run: hostname
#   Example output: Johns-MacBook-Pro
#
# Step 2: Set it here (without .local suffix):
EXPO_PUBLIC_BACKEND_HOSTNAME=YOUR-HOSTNAME-HERE

# Manual override (only if mDNS fails):
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3001/api/v1

# To test against deployed backend:
# EXPO_PUBLIC_API_URL=https://parkpal-backend-dev-cxntrkjjmq-as.a.run.app/api/v1

# ============================================
# GOOGLE MAPS API KEYS
# ============================================
# Get your API keys from: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY_IOS=YOUR_IOS_API_KEY_HERE
GOOGLE_MAPS_API_KEY_ANDROID=YOUR_ANDROID_API_KEY_HERE

# ============================================
# GOOGLE SIGN-IN
# ============================================
# Requires an Expo development build or standalone build. Expo Go is not supported.
# Web OAuth client ID used by mobile and backend audience verification.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=YOUR_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com

# iOS OAuth client ID for bundle ID com.parknquik.mobile.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Reversed iOS client ID URL scheme.
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.YOUR_REVERSED_IOS_CLIENT_ID

# ============================================
# FACEBOOK SIGN-IN
# ============================================
# Required before Facebook Sign-In works in native development builds.
FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID
FACEBOOK_CLIENT_TOKEN=YOUR_FACEBOOK_CLIENT_TOKEN
FACEBOOK_DISPLAY_NAME=ParknQuik
