# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files - NEVER commit these
.env
.env.local
.env*.local

# Google Maps API keys - NEVER commit actual keys
# Keep .env.development, .env.staging, .env.production with placeholders only
# Individual developers use .env.local for their actual keys

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
coverage/
