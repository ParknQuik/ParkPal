# Development Environment
# This file can be committed (with placeholder values) for team consistency
# Individual developers should override values in .env.local (not committed)

EXPO_PUBLIC_ENV=development

# Local development API - Update this to your machine's IP
EXPO_PUBLIC_API_URL=http://192.168.100.176:3001/api/v1

# Development API keys - Replace with your actual keys in .env.local
GOOGLE_MAPS_API_KEY_IOS=YOUR_IOS_API_KEY_HERE
GOOGLE_MAPS_API_KEY_ANDROID=YOUR_ANDROID_API_KEY_HERE
