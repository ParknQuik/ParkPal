# Development Environment (Local Development)
# This file can be committed to git

EXPO_PUBLIC_ENV=development

# Backend API - Platform defaults for local development
# iOS Simulator: http://localhost:3001/api/v1
# Android Emulator: http://10.0.2.2:3001/api/v1
# Override in .env.local if needed

# Google Maps API Keys
# Override in .env.local with your actual keys
GOOGLE_MAPS_API_KEY_IOS=YOUR_IOS_API_KEY_HERE
GOOGLE_MAPS_API_KEY_ANDROID=YOUR_ANDROID_API_KEY_HERE

# Google Sign-In
# Override in .env.local with actual OAuth client values.
# Requires an Expo development build; Expo Go is not supported.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=YOUR_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.YOUR_REVERSED_IOS_CLIENT_ID
