# ParknQuik Mobile - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains sensitive API keys

# ============================================
# ENVIRONMENT
# ============================================
# Options: development, staging, production
EXPO_PUBLIC_ENV=development

# ============================================
# BACKEND API
# ============================================
# Development (local): Use your local IP address (not localhost)
# Staging: Use your staging server URL
# Production: Use your production server URL
EXPO_PUBLIC_API_URL=http://192.168.100.176:3001/api/v1

# ============================================
# GOOGLE MAPS API KEYS
# ============================================
# Get your API keys from: https://console.cloud.google.com/google/maps-apis
#
# IMPORTANT: Create separate keys for iOS and Android
# - iOS: Restrict to iOS app bundle ID (com.parknquik.mobile)
# - Android: Restrict to Android app SHA-1 fingerprint + package name
#
# Required APIs to enable:
# - Maps SDK for iOS
# - Maps SDK for Android
# - Places API
# - Geocoding API

# iOS Google Maps API Key (restricted to bundle ID: com.parknquik.mobile)
GOOGLE_MAPS_API_KEY_IOS=YOUR_IOS_API_KEY_HERE

# Android Google Maps API Key (restricted to app signature + package name)
GOOGLE_MAPS_API_KEY_ANDROID=YOUR_ANDROID_API_KEY_HERE

# ============================================
# EAS BUILD (Optional - only needed for EAS builds)
# ============================================
# Your EAS project ID (get this from: npx eas init)
# EAS_PROJECT_ID=your-eas-project-id-here
